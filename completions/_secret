#compdef secret
# Имена берутся из кэша: на заблокированном keychain запрос к нему открыл бы окно пароля.

_secret_names() {
  local f="${SECRET_NAMES_CACHE:-$HOME/.local/state/secret/names}"
  [[ -r $f ]] || return 1
  local -a names
  names=(${(f)"$(<$f)"})
  _describe -t names 'secret' names
}

_secret() {
  local -a cmds
  cmds=(
    'init:create the keychain'
    'unlock:unlock the keychain'
    'lock:lock the keychain'
    'set:store or update a secret'
    'ask:store a secret through a dialog'
    'gen:generate and store a random value'
    'expire:set or remove the expiry date'
    'note:set or show the comment'
    'get:print the value'
    'has:check that a secret exists'
    'ls:list secrets'
    'copy:copy the value to the clipboard'
    'gh:store the value as a GitHub Actions secret'
    'mv:rename a secret'
    'rm:delete a secret'
    'run:run a command with secrets'
    'log:show the access log'
    'check:check a .env file'
    'import:move a .env file into the keychain'
    'migrate:move all secrets to or from the Secure Enclave store'
    'help:show the usage'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'secret command' cmds
    return
  fi
  case $words[2] in
    run)
      local i=${words[(I)--]}
      if (( i > 2 && CURRENT > i )); then
        words=("${(@)words[i+1,-1]}")
        (( CURRENT -= i ))
        _normal
      elif [[ $words[CURRENT-1] == (-e|--env-file) ]]; then
        _files
      else
        _alternative 'options:option:(--mask -e --)' 'names:secret:_secret_names'
      fi
      ;;
    set|gen)
      case $words[CURRENT-1] in
        -s) _values 'set' alnum symbols hex ;;
        -c|-l|-x) _message 'value' ;;
        *) _alternative 'options:option:(-c -x -l -s -f)' 'names:secret:_secret_names' ;;
      esac
      ;;
    get|has|rm|note|copy|gh|mv|expire|ask|log) _secret_names ;;
    ls) _values 'option' -l --expiring ;;
    check) _files ;;
    import) _alternative 'options:option:(-p -k)' 'files:file:_files' ;;
    migrate) _alternative 'options:option:(--backup --back --pass-stdin)' 'files:file:_files' ;;
  esac
}

_secret "$@"
