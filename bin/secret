#!/bin/bash
# secret: store and use secrets in a separate macOS keychain ("secrets" by default).
# Items are generic passwords with account "secret-cli" and service = NAME.
# Visible in Keychain Access under Custom Keychains.
set -euo pipefail

ACCT="secret-cli"
KC="${SECRET_KEYCHAIN:-$HOME/Library/Keychains/secrets.keychain-db}"
LOCK_TIMEOUT="${SECRET_LOCK_TIMEOUT:-28800}"   # seconds of inactivity before auto-lock
DEFAULT_KC="$HOME/Library/Keychains/secrets.keychain-db"
SELF="$0"
while [ -L "$SELF" ]; do
  t="$(readlink "$SELF")"
  case "$t" in /*) SELF="$t" ;; *) SELF="$(dirname "$SELF")/$t" ;; esac
done
ROOT="$(cd -P "$(dirname "$SELF")/.." && pwd)"

# Overrides for tests work only with a keychain file that is not the default one (other inode),
# so they cannot switch off Touch ID or the clipboard for the real secrets.
is_test_kc() {
  # Fail closed: only an existing keychain file can be a test keychain (013).
  [ -f "$KC" ] || return 1
  # Without the default file (deleted after migrate) the inodes cannot differ: compare paths.
  # No alias of a missing file exists, so another path is not the default keychain.
  if [ ! -e "$DEFAULT_KC" ]; then [ "$KC" != "$DEFAULT_KC" ]; return; fi
  [ "$(stat -L -f %d:%i "$KC" 2>/dev/null)" != "$(stat -L -f %d:%i "$DEFAULT_KC" 2>/dev/null)" ]
}
test_override() {
  local v
  eval "v=\${$1:-}"
  if [ -n "$v" ] && is_test_kc; then printf '%s' "$v"; else printf '%s' "$2"; fi
}
HELPER="$(test_override SECRET_AUTH_HELPER "$ROOT/build/secret-auth")"

# The Secure Enclave store (017, 018): helper secret-vault, on when the mode file says "vault".
# A test keychain (SECRET_KEYCHAIN) means the file keychain, unless SECRET_STORE_MODE is set too.
REAL_VAULT="$ROOT/build/secret-vault"
STORE="$(test_override SECRET_VAULT_HELPER "$REAL_VAULT")"
# A test helper must say so: else the test variables could lead a copy of the release helper to
# the real store, and SECRET_PBCOPY could take a real value (013).
if [ "$STORE" != "$REAL_VAULT" ] && [ "$("$STORE" kind 2>/dev/null)" != test ]; then STORE="$REAL_VAULT"; fi
STORE_NAME="secure enclave store"
# Store selection. The default keychain path: the mode file of the owner. Another keychain path:
# the file keychain, or a test store, but only with a test helper. Test variables never lead to
# the real store.
if [ "$KC" = "$DEFAULT_KC" ]; then
  STORE_MODE_FILE="$HOME/.local/state/secret/store"
elif is_test_kc && [ "$STORE" != "$REAL_VAULT" ]; then
  STORE_MODE_FILE="${SECRET_STORE_MODE:-}"
else
  STORE_MODE_FILE=""
fi
MODE=""
[ -z "$STORE_MODE_FILE" ] || MODE="$(cat "$STORE_MODE_FILE" 2>/dev/null || true)"
IN_STORE=""
in_store() {
  if [ -z "$IN_STORE" ]; then
    IN_STORE=0
    case "$MODE" in
      vault) IN_STORE=1 ;;
      dp) echo "secret: the data protection store is gone (018): $STORE_MODE_FILE says dp" >&2; exit 1 ;;
    esac
  fi
  [ "$IN_STORE" = 1 ]
}

# The helper starts and opens the store: a damaged file or a changed key item stops here.
store_check() {
  [ -x "$STORE" ] || die "the $STORE_NAME is on, but its helper is not built (run $ROOT/install.sh)"
  local err
  err="$("$STORE" ping 2>&1 >/dev/null)" || die "the store helper failed: ${err:-no output, it did not start}"
}

usage() {
  cat <<'EOF'
Usage:
  secret init                  create the keychain and add it to Keychain Access
  secret touchid on|off|status protected mode: only the helper (build/) reads the values,
                               after Touch ID; get, copy, run, export, mv ask for it
  secret touchid repair        secure enclave store: rebuild its keychain item from the store file
  secret touchid grace SECONDS no new question for SECONDS after a confirmation (default 300);
                               secure enclave store: SECONDS without requests (default 1800),
                               8 hours at most, a locked screen or a sleep ends it
  secret migrate --backup FILE [--pass-stdin]
                               move all secrets to the Secure Enclave store (needs the store
                               helper: ./install.sh with swiftc); FILE gets an encrypted
                               copy first (as export)
  secret migrate --back        move all secrets back to the file keychain
  secret unlock / lock         unlock (asks for the keychain password) / lock now
  secret set [-c COMMENT] [-x YYYY-MM-DD] NAME [VALUE]
                               store or update; without VALUE reads stdin or prompts hidden
                               -x: expiry date (kept on update when not given)
  secret expire NAME YYYY-MM-DD|none
                               set or remove the expiry date
  secret note NAME [COMMENT]   set the comment (shown in Keychain Access); without COMMENT print it
  secret ask NAME [TEXT]       store or update via a macOS dialog with hidden input
  secret gen [-l LEN] [-s alnum|symbols|hex] [-c COMMENT] [-f] NAME
                               generate a random value and store it; prints no value
                               LEN 8..256 (default 32); -f replaces an existing NAME
  secret get NAME              print the value
  secret has NAME              exit 0 if NAME exists, 1 otherwise (prints nothing)
  secret ls [-l]               list names; -l adds expiry dates and comments
  secret ls --expiring [DAYS]  secrets that expired or expire in DAYS days (default 30)
  secret copy NAME [SECONDS]   copy the value to the clipboard, clear it after SECONDS (default 30)
  secret gh NAME [GH_NAME] [-R OWNER/REPO] [-e ENV] [-o ORG [-v VISIBILITY]] [-a APP]
                               store the value as a GitHub Actions secret GH_NAME (default
                               NAME) with gh secret set; asks the user to confirm each time;
                               the flags go to gh as they are, -b and -f are not allowed
  secret mv [-f] OLD NEW       rename; -f replaces an existing NEW
  secret rm NAME               delete
  secret run [--mask|--no-mask] [-e FILE]... [SPEC...] -- CMD
                               run CMD with secrets in its environment
                               --mask: replace secret values with *** in its output
                               (always on under Claude Code, CLAUDECODE is set)
                               SPEC is NAME (env var NAME) or VAR=NAME
                               FILE is a dotenv file; values "secret:NAME" are
                               read from the Keychain, other values pass as is
                               no SPEC and no -e: uses ./.env
  secret export [-f] [--pass-stdin] FILE
                               save all secrets to FILE, encrypted with a backup password
  secret restore [-f] [--pass-stdin] FILE
                               restore from FILE; -f replaces secrets that exist
                               --pass-stdin: read the backup password from stdin
  secret log [-n N] [NAME]     show the access log (no values), last N lines (default 20)
  secret check [FILE]          show which keys are references and if they exist
  secret import [-p PREFIX] [-k] [--keys KEY,KEY] [--ref KEY=NAME]... [FILE]
                               store plain values of FILE (default .env) in the
                               Keychain as PREFIX+KEY and rewrite FILE with references
                               -k, --keep: store only, do not change FILE
                               --keys: only these keys, other lines stay as they are
                               --ref: KEY becomes secret:NAME of an existing secret;
                               without --keys, --ref moves no other key

Prefer stdin over VALUE: an argument is visible in ps and shell history.
Keychain: $SECRET_KEYCHAIN (default ~/Library/Keychains/secrets.keychain-db), or the Secure
Enclave store after secret migrate (~/.local/state/secret/store has "vault").
SECRET_NO_DIALOG=1: fail instead of opening a dialog (no terminal, keychain locked).
SECRET_RUN_MASK=1: run uses --mask by default.
SECRET_LOG: access log file (default ~/.local/state/secret/access.log), "off" disables it.
EOF
}

die() { echo "secret: $*" >&2; exit 1; }

check_name() {
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ ]] || die "bad name: $1"
}

# Escape a value for a double-quoted argument of 'security -i'.
esc() { printf '%s' "$1" | sed 's/[\\"]/\\&/g'; }

# Run one 'security' command given on stdin, so secrets are not in argv.
sec_i() { printf '%s\n' "$1" | security -i >/dev/null 2>&1; }

# Hidden-input dialog. Prints the answer; fails on Cancel.
dialog() {
  osascript - "$1" "$2" 2>/dev/null <<'OSA'
on run argv
  set r to display dialog (item 2 of argv) with title (item 1 of argv) default answer "" with hidden answer buttons {"Cancel", "OK"} default button "OK"
  return text returned of r
end run
OSA
}

# Read a password from the terminal, or from a dialog when there is no terminal.
ask_password() {
  local v
  if [ -t 0 ] && [ -t 2 ]; then
    read -r -s -p "$1: " v; echo >&2
  elif [ -n "${SECRET_NO_DIALOG:-}" ]; then
    return 1
  else
    v="$(dialog "secret" "$1")" || return 1
  fi
  printf '%s' "$v"
}

# With the helper there is no system password dialog for a locked keychain.
is_unlocked() {
  if in_store; then return 0; fi
  if [ -x "$HELPER" ]; then
    [ "$("$HELPER" status "$KC" 2>/dev/null)" = unlocked ]
  else
    security show-keychain-info "$KC" >/dev/null 2>&1
  fi
}

POLICY_NAME="__secret-cli.policy"

# Attributes only: no value is read, so no dialog for any item.
item_exists() {
  if in_store; then "$STORE" has "$1" 2>/dev/null; return; fi
  security find-generic-password -a "$ACCT" -s "$1" "$KC" >/dev/null 2>&1
}

# Delete NAME. Needs no Touch ID in both stores.
delete_item() {
  if in_store; then "$STORE" delete "$1" >/dev/null 2>&1; return; fi
  security delete-generic-password -a "$ACCT" -s "$1" "$KC" >/dev/null 2>&1
}

# Protected mode (Touch ID on): the helper created the items and is the only app that reads them.
PROTECTED=""
is_protected() {
  [ -n "$PROTECTED" ] || { if item_exists "$POLICY_NAME"; then PROTECTED=1; else PROTECTED=0; fi; }
  [ "$PROTECTED" = 1 ]
}

need_helper() { [ -x "$HELPER" ] || die "Touch ID is on, but the helper is not built (run install.sh)"; }

# Owner of NAME for the helper: mine, foreign or missing. Without the helper: foreign.
# Items of the helper always go through it, also when the policy is gone: else security opens a dialog.
owner_of() {
  if [ -x "$HELPER" ]; then "$HELPER" owner "$KC" "$1" 2>/dev/null || echo foreign; else echo foreign; fi
}

# Print the values of NAMEs, one per line, in order. Items of the helper: one call, one Touch ID.
read_values() {
  local reason="$1" n line
  shift
  [ $# -gt 0 ] || return 0
  if in_store; then
    "$STORE" read "$reason" "$@" | while IFS= read -r line; do printf '%s' "$line" | xxd -r -p; echo; done
    return
  fi
  if is_protected; then
    need_helper
    "$HELPER" read "$KC" "$reason" "$@" | while IFS= read -r line; do printf '%s' "$line" | xxd -r -p; echo; done
    return
  fi
  local owners=() i=0
  if [ -x "$HELPER" ]; then
    while IFS= read -r line; do owners+=("$line"); done < <("$HELPER" owner "$KC" "$@" 2>/dev/null)
  fi
  for n in "$@"; do
    if [ "${owners[$i]:-foreign}" = mine ]; then
      "$HELPER" read "$KC" "$reason" "$n" | xxd -r -p; echo
    else
      security find-generic-password -a "$ACCT" -s "$n" -w "$KC" 2>/dev/null || die "not found: $n"
    fi
    i=$((i + 1))
  done
}

# Value of one item for an internal step (mv, note in the normal mode).
lookup_value() { read_values "$2" "$1"; }

cmd_touchid() {
  if in_store; then touchid_store "$@"; return; fi
  case "${1:-status}" in
    on) touchid_on ;;
    off) touchid_off ;;
    grace)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "grace needs SECONDS"
      need_helper; ensure_keychain
      is_protected || die "Touch ID is off (secret touchid on)"
      "$HELPER" policy grace "$KC" "$2" || die "touchid: not changed"
      echo "touchid grace: ${2}s" >&2 ;;
    status)
      local h=no state=off grace=-
      [ -x "$HELPER" ] && h=yes
      ensure_keychain
      if is_protected; then
        state=on
        [ "$h" = no ] || grace="$("$HELPER" policy show "$KC" 2>/dev/null)"
      fi
      echo "touchid: $state, ${grace#grace=}s grace, helper built: $h" ;;
    *) die "touchid needs on, off, status or grace SECONDS" ;;
  esac
}

# In the Secure Enclave store every value needs .userPresence: Touch ID cannot be off.
touchid_store() {
  if [ "${1:-}" = repair ]; then
    # a new key item from the store file, one Touch ID (017); before ensure_keychain, which stops
    # on a missing or changed item
    [ -x "$STORE" ] || die "the $STORE_NAME is on, but its helper is not built (run $ROOT/install.sh)"
    "$STORE" repair || die "touchid: not repaired"
    return
  fi
  ensure_keychain
  case "${1:-status}" in
    on) echo "touchid: always on in the $STORE_NAME" >&2 ;;
    off) die "touchid: always on in the $STORE_NAME (secret migrate --back leaves it)" ;;
    grace)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "grace needs SECONDS"
      [ "$2" -le 3600 ] || die "grace must be 3600 seconds or less"
      "$STORE" policy grace "$2" || die "touchid: not changed"
      echo "touchid grace: ${2}s" >&2 ;;
    status)
      # grace is sliding (010): a new question after IDLE seconds without requests, 8 hours at most
      local grace st state="grace off"
      grace="$("$STORE" policy show 2>/dev/null)"; grace="${grace#grace=}"
      [[ "$grace" =~ ^[0-9]+$ ]] || grace=0
      st="$("$STORE" grace-status 2>/dev/null || echo off)"
      if [ "${st%% *}" = active ]; then
        set -- $st
        state="grace active: ${2}s left, ${4}s to the 8h limit"
      fi
      echo "touchid: on, ${grace}s idle, $state, store: secure enclave" ;;
    *) die "touchid needs on, off, status, repair or grace SECONDS" ;;
  esac
}

# Items that the helper does not own yet move to it: value through a pipe, never in argv.
touchid_on() {
  need_helper; ensure_keychain
  if ! is_protected; then
    "$HELPER" policy init "$KC" 300 || die "touchid: not turned on"
    PROTECTED=1
  fi
  local names=() owners=() name c g i=0 n=0 value
  items_load
  while IFS=$'\t' read -r name c g; do names+=("$name"); done < <(list_items)
  [ ${#names[@]} -eq 0 ] || while IFS= read -r c; do owners+=("$c"); done < <("$HELPER" owner "$KC" "${names[@]}")
  for name in ${names[@]+"${names[@]}"}; do
    if [ "${owners[$i]}" = foreign ]; then
      value="$(security find-generic-password -a "$ACCT" -s "$name" -w "$KC" 2>/dev/null)" || die "cannot read $name"
      printf '%s' "$value" | "$HELPER" write "$KC" "$name" --comment "$(get_comment "$name")" --expiry "$(get_expiry "$name")" \
        || die "cannot protect $name (run secret touchid on again)"
      n=$((n + 1))
    fi
    i=$((i + 1))
  done
  value=""
  echo "touchid: on, $n secrets moved to the helper" >&2
}

# install.sh: move the items of the current helper to NEW (another cdhash), then NEW replaces it.
# Only items that the current helper still owns move, so a second run finishes an interrupted one.
cmd_rehelper() {
  IN_STORE=0  # the file keychain only
  local new="$1" names=() old=() name c g i=0 o values=() grace
  [ -x "$new" ] || die "no new helper: $new"
  [ -x "$HELPER" ] || { echo "rehelper: no current helper" >&2; return 0; }
  [ -f "$KC" ] || { echo "rehelper: no keychain" >&2; return 0; }
  ensure_keychain
  items_load
  while IFS=$'\t' read -r name c g; do names+=("$name"); done < <(list_items)
  [ ${#names[@]} -eq 0 ] || while IFS= read -r o; do
    [ "$o" != mine ] || old+=("${names[$i]}")
    i=$((i + 1))
  done < <("$HELPER" owner "$KC" "${names[@]}")
  if is_protected; then
    grace="$("$HELPER" policy show "$KC" 2>/dev/null)"; grace="${grace#grace=}"
    [[ "$grace" =~ ^[0-9]+$ ]] || grace=300
  fi
  if [ ${#old[@]} -gt 0 ]; then
    while IFS= read -r o; do values+=("$o"); done < <("$HELPER" read "$KC" "update the secret helper" "${old[@]}" \
      | while IFS= read -r o; do printf '%s' "$o" | xxd -r -p; echo; done)
    [ ${#values[@]} -eq ${#old[@]} ] || die "rehelper: cannot read the secrets, the current helper is kept"
  fi
  if is_protected && [ "$("$new" owner "$KC" "$POLICY_NAME")" != mine ]; then
    "$new" policy init "$KC" "$grace" || die "rehelper: Touch ID policy not moved, the current helper is kept"
  fi
  i=0
  for name in ${old[@]+"${old[@]}"}; do
    printf '%s' "${values[$i]}" | "$new" write "$KC" "$name" --comment "$(get_comment "$name")" --expiry "$(get_expiry "$name")" \
      || die "rehelper: cannot move $name, run ./install.sh again"
    i=$((i + 1))
  done
  values=()
  echo "rehelper: ${#old[@]} secrets moved to the new helper" >&2
}

# Items go back to /usr/bin/security as their owner.
touchid_off() {
  need_helper; ensure_keychain
  local names=() mine=() name c g i=0 o values=()
  items_load
  while IFS=$'\t' read -r name c g; do names+=("$name"); done < <(list_items)
  [ ${#names[@]} -eq 0 ] || while IFS= read -r o; do
    [ "$o" != mine ] || mine+=("${names[$i]}")
    i=$((i + 1))
  done < <("$HELPER" owner "$KC" "${names[@]}")
  if [ ${#mine[@]} -gt 0 ]; then
    while IFS= read -r o; do values+=("$o"); done < <(read_values "turn off Touch ID for secret" "${mine[@]}")
    [ ${#values[@]} -eq ${#mine[@]} ] || die "touchid: cannot read the secrets"
  fi
  if is_protected; then "$HELPER" policy remove "$KC" || die "touchid: not turned off"; fi
  PROTECTED=0
  i=0
  for name in ${mine[@]+"${mine[@]}"}; do
    c="$(get_comment "$name")"; g="$(get_expiry "$name")"
    write_item "$name#plain" "${values[$i]}" "$c" "$g" || die "cannot write $name"
    security delete-generic-password -a "$ACCT" -s "$name" "$KC" >/dev/null 2>&1 || die "cannot delete $name, $name#plain has the value"
    write_item "$name" "${values[$i]}" "$c" "$g" || die "cannot write $name, $name#plain has the value"
    security delete-generic-password -a "$ACCT" -s "$name#plain" "$KC" >/dev/null 2>&1 || true
    i=$((i + 1))
  done
  values=()
  echo "touchid: off, ${#mine[@]} secrets moved back" >&2
}

ensure_keychain() {
  if in_store; then store_check; return; fi
  [ -f "$KC" ] || die "keychain not found: $KC (run: secret init)"
  is_unlocked && return 0
  local pw i
  for i in 1 2 3; do
    pw="$(ask_password "Password for keychain $(basename "$KC" .keychain-db)")" || die "keychain is locked"
    sec_i "unlock-keychain -p \"$(esc "$pw")\" \"$KC\"" && return 0
    echo "secret: wrong password" >&2
  done
  die "keychain is locked"
}

cmd_init() {
  if in_store; then echo "ready: the $STORE_NAME is in use" >&2; return 0; fi
  if [ ! -f "$KC" ]; then
    local pw pw2
    pw="$(ask_password "New password for keychain $(basename "$KC" .keychain-db)")" || die "cancelled"
    [ -n "$pw" ] || die "empty password"
    pw2="$(ask_password "Repeat the password")" || die "cancelled"
    [ "$pw" = "$pw2" ] || die "passwords do not match"
    sec_i "create-keychain -p \"$(esc "$pw")\" \"$KC\"" || die "create failed"
    echo "created: $KC" >&2
  fi
  # Lock on sleep and after LOCK_TIMEOUT seconds without use.
  is_unlocked || ensure_keychain
  security set-keychain-settings -l -u -t "$LOCK_TIMEOUT" "$KC"
  # Add to the user search list (keeps the existing keychains), so Keychain Access shows it.
  local list=() k
  while IFS= read -r k; do
    k="${k#"${k%%[![:space:]]*}"}"; k="${k#\"}"; k="${k%\"}"
    [ -n "$k" ] && list+=("$k")
  done < <(security list-keychains -d user)
  for k in ${list[@]+"${list[@]}"}; do [ "$k" = "$KC" ] && { echo "ready: $KC" >&2; return 0; }; done
  security list-keychains -d user -s ${list[@]+"${list[@]}"} "$KC"
  echo "ready: $KC (added to Keychain Access)" >&2
}

cmd_unlock() {
  if in_store; then echo "the $STORE_NAME has no own lock: it is open while you are logged in" >&2; return 0; fi
  ensure_keychain; echo "unlocked" >&2
}
# Data protection store: the end of grace, the next read asks for Touch ID.
cmd_lock() {
  if in_store; then [ ! -x "$STORE" ] || "$STORE" lock; echo "locked: grace ended" >&2; return 0; fi
  security lock-keychain "$KC" && echo "locked" >&2
}

LOG="${SECRET_LOG:-$HOME/.local/state/secret/access.log}"

# Log line: time, operation, agent|human, names, detail. Never values.
# Who: agent (Claude Code), else the source that SecretBar names (secretbar, shortcuts), else human.
# SECRET_VIA cannot hide the agent: CLAUDECODE goes first.
audit() {
  [ "$LOG" != off ] || return 0
  local who=human
  case "${SECRET_VIA:-}" in secretbar|shortcuts) who="$SECRET_VIA" ;; esac
  [ -z "${CLAUDECODE:-}" ] || who=agent
  if ! ( umask 077; mkdir -p "$(dirname "$LOG")" \
      && printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$who" "$2" "${3:--}" >> "$LOG" ) 2>/dev/null; then
    echo "secret: cannot write log $LOG" >&2
  fi
}


# Decode a blob attribute as printed by 'security': "text" or 0xHEX  "escaped".
decode_blob() {
  case "$1" in
    0x*) local h="${1#0x}"; printf '%s' "${h%% *}" | xxd -r -p ;;
    \"*) local t="${1#\"}"; printf '%s' "${t%\"}" ;;
  esac
}

# Print attribute ATTR (icmt: comment, gena: expiry) of NAME, empty if none.
get_attr() {
  decode_blob "$(security find-generic-password -a "$ACCT" -s "$1" "$KC" 2>/dev/null \
    | sed -n "s/^ *\"$2\"<blob>=//p")"
}
get_comment() {
  local r c
  in_store && items_load  # the store has no per-item attribute call in bash: one list
  if [ $ITEMS_LOADED -eq 1 ]; then
    r="$(item_row "$1")" || return 0
    c="${r%%$'\t'*}"; [ "$c" = - ] || printf '%s' "$c"; return
  fi
  get_attr "$1" icmt
}

# Print the expiry date of an item as year-month-day, empty if none.
get_expiry() {
  local r g
  in_store && items_load  # the store has no per-item attribute call in bash: one list
  if [ $ITEMS_LOADED -eq 1 ]; then
    r="$(item_row "$1")" || return 0
    g="${r#*$'\t'}"; [ "$g" = - ] || printf '%s' "$g"; return
  fi
  g="$(get_attr "$1" gena)"; [ "${g#expires=}" = "$g" ] || printf '%s' "${g#expires=}"
}

# Write NAME with VALUE, COMMENT and EXPIRY. The value goes through stdin, never in argv.
write_item() {
  if in_store; then
    printf '%s %s %s %s\n' "$(hex "$1")" "$(hex "$2")" "$(hex "$3")" "$(hex "${4:-}")" | "$STORE" write
    return
  fi
  if is_protected || [ "$(owner_of "$1")" = mine ]; then
    need_helper
    printf '%s' "$2" | "$HELPER" write "$KC" "$1" --comment "$3" --expiry "${4:-}"
    return
  fi
  local gena=""
  [ -z "${4:-}" ] || gena="expires=$4"
  sec_i "add-generic-password -U -a $ACCT -s \"$1\" -D \"secret-cli\" -j \"$(esc "$3")\" -G \"$gena\" -w \"$(esc "$2")\" \"$KC\""
}

# Change the comment and the expiry. Protected: without the value (attributes are not protected).
set_attrs() {
  if in_store; then "$STORE" attrs "change $1" "$1" "$2" "$3"; return; fi
  if is_protected || [ "$(owner_of "$1")" = mine ]; then
    need_helper
    "$HELPER" attrs "$KC" "$1" --comment "$2" --expiry "$3"
  else
    local value
    value="$(lookup_value "$1" "")" || return 1
    write_item "$1" "$value" "$2" "$3"
  fi
}

check_date() {
  [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
    && [ "$(date -j -f %Y-%m-%d "$1" +%Y-%m-%d 2>/dev/null)" = "$1" ] || die "bad date: $1 (YYYY-MM-DD)"
}

# Days from today to DATE; negative when DATE is in the past.
days_left() {
  local today exp
  today="$(date -j -f '%Y-%m-%d %H:%M:%S' "$(date +%Y-%m-%d) 00:00:00" +%s)"
  exp="$(date -j -f '%Y-%m-%d %H:%M:%S' "$1 00:00:00" +%s)"
  echo $(( (exp - today) / 86400 ))
}

warn_expired() {
  local d
  d="$(get_expiry "$1")"
  [ -n "$d" ] && [ "$(days_left "$d")" -lt 0 ] && echo "secret: warning: $1 expired on $d" >&2
  return 0
}

NAMES_CACHE="${SECRET_NAMES_CACHE:-$HOME/.local/state/secret/names}"

# Name, comment and expiry date of each item, TAB-separated, sorted, "-" for empty.
# One dump-keychain for all items; awk decodes the hex form of the attributes.
list_items() {
  if in_store; then "$STORE" list; return; fi
  security dump-keychain "$KC" 2>/dev/null | LC_ALL=C awk -v acct="$ACCT" '
    function hexv(c) { return index("0123456789abcdef", tolower(c)) - 1 }
    function dec(v,   h, i, o) {
      if (v ~ /^0x/) { h = substr(v, 3); sub(/ .*/, "", h); o = ""
        for (i = 1; i < length(h); i += 2) o = o sprintf("%c", hexv(substr(h, i, 1)) * 16 + hexv(substr(h, i + 1, 1)))
        return o }
      if (v ~ /^"/) { sub(/^"/, "", v); sub(/"$/, "", v); return v }
      return ""
    }
    function out(   d) {
      if (a != acct || s == "") return
      d = dec(g); if (d !~ /^expires=/) d = ""; else sub(/^expires=/, "", d)
      c = dec(c)
      printf "%s\t%s\t%s\n", s, (c == "" ? "-" : c), (d == "" ? "-" : d)
    }
    /^keychain:/ { out(); a = ""; s = ""; c = ""; g = "" }
    /"acct"<blob>=/ { v = $0; sub(/.*<blob>=/, "", v); a = dec(v) }
    /"svce"<blob>=/ { v = $0; sub(/.*<blob>=/, "", v); s = dec(v) }
    /"icmt"<blob>=/ { v = $0; sub(/.*<blob>=/, "", v); c = v }
    /"gena"<blob>=/ { v = $0; sub(/.*<blob>=/, "", v); g = v }
    END { out() }
  ' | sort -u | grep -v -e '^__secret-cli\.' -e '#new	' -e '#plain	' || true
}

# Attribute cache for the loops of check, run, import and the others: one dump instead of a
# security call per item. One shell variable per item (IC_<name>), so a lookup is O(1).
ITEMS_LOADED=0
# Name to variable: _ -> _5F, . -> _2E, - -> _2D (names have only A-Za-z0-9_.-).
item_var() { local n="${1//_/_5F}"; n="${n//./_2E}"; ITEM_VAR="IC_${n//-/_2D}"; }
items_load() {
  [ $ITEMS_LOADED -eq 0 ] || return 0
  local name c g
  while IFS=$'\t' read -r name c g; do
    [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ ]] || continue
    item_var "$name"; printf -v "$ITEM_VAR" '%s\t%s' "$c" "$g"
  done < <(list_items)
  ITEMS_LOADED=1
}
# Print "comment<TAB>expiry" of NAME from the cache; 1 if NAME is not in it.
item_row() {
  item_var "$1"
  [ -n "${!ITEM_VAR:-}" ] || return 1
  printf '%s' "${!ITEM_VAR}"
}
items_put() {
  [ $ITEMS_LOADED -eq 1 ] || return 0
  item_var "$1"; printf -v "$ITEM_VAR" '%s\t%s' "${2:--}" "${3:--}"
}
items_del() {
  [ $ITEMS_LOADED -eq 1 ] || return 0
  item_var "$1"; unset "$ITEM_VAR"
}
# Is NAME there? From the cache when it is loaded, else one security call.
item_known() {
  if [ $ITEMS_LOADED -eq 1 ]; then item_row "$1" >/dev/null; else item_exists "$1"; fi
}

# Names for zsh completion: the completion reads this file and does not open the keychain.
refresh_names() {
  ( umask 077; mkdir -p "$(dirname "$NAMES_CACHE")" \
    && list_items | cut -f1 > "$NAMES_CACHE.tmp" && mv "$NAMES_CACHE.tmp" "$NAMES_CACHE" ) 2>/dev/null || true
}

cmd_set() {
  local comment="" has_comment=0 expiry="" has_expiry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -c) [ $# -ge 2 ] || die "-c needs COMMENT"; comment="$2"; has_comment=1; shift 2 ;;
      -x) [ $# -ge 2 ] || die "-x needs DATE"; check_date "$2"; expiry="$2"; has_expiry=1; shift 2 ;;
      *) break ;;
    esac
  done
  [ $# -ge 1 ] || die "set needs NAME"
  local name="$1" value
  check_name "$name"
  if [ $# -ge 2 ]; then
    value="$2"
  elif [ -t 0 ]; then
    read -r -s -p "Value for $name: " value; echo >&2
  else
    value="$(cat)"
  fi
  [ -n "$value" ] || die "empty value"
  [[ "$value" != *$'\n'* ]] || die "multi-line values are not supported"
  ensure_keychain
  [ $has_comment -eq 1 ] || comment="$(get_comment "$name")"
  [ $has_expiry -eq 1 ] || expiry="$(get_expiry "$name")"
  write_item "$name" "$value" "$comment" "$expiry" || die "keychain write failed"
  item_exists "$name" || die "keychain write not confirmed"
  items_put "$name" "$comment" "$expiry"
  [ "${BATCH:-0}" = 1 ] || refresh_names
  echo "stored: $name" >&2
}

cmd_expire() {
  [ $# -eq 2 ] || die "expire needs NAME and DATE (or none)"
  check_name "$1"
  [ "$2" = none ] || check_date "$2"
  ensure_keychain
  item_exists "$1" || die "not found: $1"
  local d="$2"
  [ "$d" != none ] || d=""
  set_attrs "$1" "$(get_comment "$1")" "$d" || die "keychain write failed"
  echo "expiry: $1 ${d:-none}" >&2
}

cmd_mv() {
  local force=0
  if [ "${1:-}" = "-f" ]; then force=1; shift; fi
  [ $# -eq 2 ] || die "mv needs OLD and NEW"
  check_name "$1"; check_name "$2"
  [ "$1" != "$2" ] || die "OLD and NEW are the same"
  ensure_keychain
  local value
  item_exists "$1" || die "not found: $1"
  if item_exists "$2" && [ $force -eq 0 ]; then die "exists: $2 (use -f to replace)"; fi
  value="$(lookup_value "$1" "move $1 to $2")" || die "cannot read $1"
  write_item "$2" "$value" "$(get_comment "$1")" "$(get_expiry "$1")" || die "keychain write failed"
  item_exists "$2" || die "keychain write not confirmed, $1 is kept"
  delete_item "$1" || die "cannot delete $1"
  refresh_names
  echo "moved: $1 -> $2 (update references secret:$1)" >&2
}

# The Secure Enclave store copies through its helper: the clipboard gets the concealed mark, so
# clipboard managers do not keep the value (014). A test override goes first.
clip_copy() {
  local o
  o="$(test_override SECRET_PBCOPY "")"
  if [ -n "$o" ]; then sh -c "$o"
  elif in_store && [ -x "$STORE" ]; then "$STORE" clip
  else pbcopy
  fi
}
clip_paste() { sh -c "$(test_override SECRET_PBPASTE pbpaste)"; }

cmd_copy() {
  # The agent reads the clipboard (pbpaste): copy is for the user, `! secret copy NAME` (014).
  [ -z "${CLAUDECODE:-}" ] || die "copy is for the user (the agent can read the clipboard); use secret run --mask, or ask the user to run ! secret copy NAME"
  [ $# -ge 1 ] && [ $# -le 2 ] || die "copy needs NAME [SECONDS]"
  check_name "$1"
  local sec="${2:-30}" value hash
  [[ "$sec" =~ ^[0-9]+$ ]] && [ "$sec" -ge 1 ] || die "SECONDS must be a positive number"
  ensure_keychain
  item_exists "$1" || die "not found: $1"
  value="$(lookup_value "$1" "copy $1 to the clipboard")" || die "cannot read $1"
  warn_expired "$1"
  audit copy "$1"
  printf '%s' "$value" | clip_copy || die "cannot copy to the clipboard"
  hash="$(printf '%s' "$value" | shasum -a 256)"
  value=""
  # only the hash goes to the background process; other text in the clipboard is kept
  ( sleep "$sec"; [ "$(clip_paste | shasum -a 256)" = "$hash" ] && printf '' | clip_copy ) </dev/null >/dev/null 2>&1 &
  echo "copied: $1 (clears in ${sec}s)" >&2
}

# A yes/no dialog. Fails on Cancel and with SECRET_NO_DIALOG (021).
confirm() {
  local o
  o="$(test_override SECRET_CONFIRM "")"
  if [ -n "$o" ]; then [ "$o" = yes ]; return; fi
  [ -z "${SECRET_NO_DIALOG:-}" ] || return 1
  osascript - "$1" "$2" "$3" >/dev/null 2>&1 <<'OSA'
on run argv
  display dialog (item 2 of argv) with title (item 1 of argv) buttons {"Cancel", item 3 of argv} default button "Cancel" with icon caution
end run
OSA
}

# GitHub Actions secret from a secret (021). The value goes to gh on stdin; GitHub encrypts it
# and never gives it back. Every push is confirmed by the user: the agent gets no way out to a
# repository it picks.
cmd_gh() {
  [ $# -ge 1 ] || die "gh needs NAME [GH_NAME] [gh secret set flags]"
  local name="$1" ghname="$1" gh value a target="" rc=0
  shift
  if [ $# -gt 0 ] && [[ "$1" != -* ]]; then ghname="$1"; shift; fi
  check_name "$name"
  [[ "$ghname" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "GitHub secret names are letters, digits and _: $ghname"
  for a in "$@"; do
    case "$a" in
      -b|--body|--body=*|-f|--env-file|--env-file=*) die "gh: $a is not allowed, the value comes from $name" ;;
    esac
  done
  gh="$(test_override SECRET_GH gh)"
  command -v "$gh" >/dev/null 2>&1 || die "gh not found (brew install gh, then gh auth login)"
  ensure_keychain
  item_exists "$name" || die "not found: $name"
  [ $# -eq 0 ] || target=" ($*)"
  confirm "secret: GitHub" "Send the value of $name to GitHub as $ghname$target?" "Send" \
    || die "not confirmed: gh needs the user to confirm in a dialog"
  value="$(lookup_value "$name" "send $name to GitHub")" || die "cannot read $name"
  warn_expired "$name"
  audit gh "$name" "$ghname$target"
  printf '%s' "$value" | "$gh" secret set "$ghname" "$@" || rc=$?
  value=""
  [ $rc -eq 0 ] || die "gh secret set failed ($rc)"
  echo "sent: $name -> $ghname$target" >&2
}

cmd_ask() {
  [ $# -ge 1 ] || die "ask needs NAME"
  local name="$1" value
  check_name "$name"
  ensure_keychain
  [ -z "${SECRET_NO_DIALOG:-}" ] || die "ask needs a dialog, SECRET_NO_DIALOG is set"
  value="$(dialog "secret: $name" "${2:-Enter the value for $name}")" || die "cancelled"
  printf '%s' "$value" | cmd_set "$name"
}

cmd_note() {
  [ $# -ge 1 ] || die "note needs NAME"
  check_name "$1"
  ensure_keychain
  item_exists "$1" || die "not found: $1"
  if [ $# -eq 1 ]; then get_comment "$1"; echo; return; fi
  [[ "$2" != *$'\n'* ]] || die "multi-line comments are not supported"
  set_attrs "$1" "$2" "$(get_expiry "$1")" || die "keychain write failed"
  echo "noted: $1" >&2
}

cmd_get() {
  [ $# -eq 1 ] || die "get needs NAME"
  check_name "$1"
  ensure_keychain
  item_exists "$1" || die "not found: $1"
  audit get "$1"
  read_values "read $1" "$1"
}

cmd_gen() {
  local len=32 set=alnum force=0 cargs=()
  while [ $# -gt 1 ]; do
    case "$1" in
      -l) len="$2"; shift 2 ;;
      -s) set="$2"; shift 2 ;;
      -c) cargs=(-c "$2"); shift 2 ;;
      -f) force=1; shift ;;
      *) break ;;
    esac
  done
  [ $# -eq 1 ] || die "gen needs NAME"
  local name="$1" chars value=""
  check_name "$name"
  [[ "$len" =~ ^[0-9]+$ ]] && [ "$len" -ge 8 ] && [ "$len" -le 256 ] || die "length must be 8..256"
  case "$set" in
    alnum) chars='A-Za-z0-9' ;;
    symbols) chars='A-Za-z0-9!#%+.=@^_~-' ;;
    hex) chars='0-9a-f' ;;
    *) die "unknown set: $set (alnum, symbols, hex)" ;;
  esac
  ensure_keychain
  if item_exists "$name" && [ $force -eq 0 ]; then die "exists: $name (use -f to replace)"; fi
  # with symbols, a value without any symbol is generated again
  while [ ${#value} -lt "$len" ] || { [ "$set" = symbols ] && [[ "$value" != *[^A-Za-z0-9]* ]]; }; do
    [ ${#value} -lt "$len" ] || value=""
    value+="$(head -c 512 /dev/urandom | LC_ALL=C tr -dc "$chars")"
    value="${value:0:$len}"
  done
  printf '%s' "$value" | cmd_set ${cargs[@]+"${cargs[@]}"} "$name" 2>/dev/null || die "keychain write failed"
  echo "generated: $name ($len chars)" >&2
}

# "-" stands for an empty field: read would join two separators in a row
hex() { if [ -n "$1" ]; then printf '%s' "$1" | xxd -p | tr -d '\n'; else printf -- '-'; fi; }
unhex() { [ "$1" = - ] || printf '%s' "$1" | xxd -r -p; }

EXPORT_HEADER="secret-cli-export 1"
CIPHER=(-aes-256-cbc -pbkdf2 -iter 600000 -md sha256)

# Backup password: first line of stdin with --pass-stdin, else hidden input (asked twice for a new one).
backup_password() {
  local from_stdin="$1" twice="$2" pw pw2
  if [ "$from_stdin" -eq 1 ]; then
    IFS= read -r pw || true
  else
    pw="$(ask_password "Backup password")" || die "cancelled"
    if [ "$twice" -eq 1 ]; then
      pw2="$(ask_password "Repeat the backup password")" || die "cancelled"
      [ "$pw" = "$pw2" ] || die "passwords do not match"
    fi
  fi
  [ ${#pw} -ge 12 ] || die "backup password must have 12 characters or more"
  printf '%s' "$pw"
}

cmd_export() {
  local force=0 stdin=0
  while [ $# -gt 1 ]; do
    case "$1" in
      -f) force=1; shift ;;
      --pass-stdin) stdin=1; shift ;;
      *) break ;;
    esac
  done
  [ $# -eq 1 ] || die "export needs FILE"
  local file="$1"
  if [ -e "$file" ] && [ $force -eq 0 ]; then die "exists: $file (use -f to replace)"; fi
  ensure_keychain
  local pw body="" n=0 name c g value d names=() values=() i=0
  pw="$(backup_password $stdin 1)" || exit 1  # also inside ( ... ) || where set -e is off
  while IFS=$'\t' read -r name c g; do names+=("$name"); done < <(list_items)
  [ ${#names[@]} -eq 0 ] || while IFS= read -r value; do values+=("$value"); done \
    < <(read_values "export ${#names[@]} secrets to $(basename "$file")" "${names[@]}")
  [ ${#values[@]} -eq ${#names[@]} ] || die "cannot read the secrets"
  while IFS=$'\t' read -r name c g; do
    value="${values[$i]}"; i=$((i + 1))
    [ "$c" != - ] || c=""; [ "$g" != - ] || g=""
    body+="$(hex "$name") $(hex "$value") $(hex "$c") $(hex "$g")"$'\n'
    n=$((n + 1))
  done < <(list_items)
  value=""; values=()
  local sum
  sum="$(printf '%s' "$body" | shasum -a 256 | cut -d' ' -f1)"
  # plain text goes through a pipe and the password through fd 3: neither touches the disk
  ( umask 077
    printf '%s\n%ssha256 %s\n' "$EXPORT_HEADER" "$body" "$sum" \
      | openssl enc "${CIPHER[@]}" -salt -pass fd:3 -out "$file.tmp" 3< <(printf '%s' "$pw") ) \
    || { rm -f "$file.tmp"; die "encryption failed"; }
  mv "$file.tmp" "$file"
  audit export "*" "$n secrets"
  echo "exported: $n secrets to $file" >&2
}

cmd_restore() {
  local force=0 stdin=0
  while [ $# -gt 1 ]; do
    case "$1" in
      -f) force=1; shift ;;
      --pass-stdin) stdin=1; shift ;;
      *) break ;;
    esac
  done
  [ $# -eq 1 ] || die "restore needs FILE"
  local file="$1"
  [ -f "$file" ] || die "no such file: $file"
  ensure_keychain
  local pw plain
  pw="$(backup_password $stdin 0)" || exit 1
  plain="$(openssl enc -d "${CIPHER[@]}" -in "$file" -pass fd:3 3< <(printf '%s' "$pw") 2>/dev/null)" \
    || die "cannot decrypt $file (wrong password or damaged file)"
  pw=""
  local header body sum
  header="${plain%%$'\n'*}"
  [ "$header" = "$EXPORT_HEADER" ] || die "not a secret-cli backup: $file"
  body="${plain#*$'\n'}"
  sum="${body##*sha256 }"
  body="${body%sha256 *}"
  [ "$(printf '%s' "$body" | shasum -a 256 | cut -d' ' -f1)" = "$sum" ] || die "checksum mismatch: $file is damaged"
  local hn hv hc hd name restored=0 skipped=0
  items_load
  while read -r hn hv hc hd; do
    [ -n "$hn" ] || continue
    name="$(unhex "$hn")"
    check_name "$name"
    if item_known "$name" && [ $force -eq 0 ]; then skipped=$((skipped + 1)); continue; fi
    write_item "$name" "$(unhex "$hv")" "$(unhex "$hc")" "$(unhex "$hd")" || die "keychain write failed: $name"
    restored=$((restored + 1))
  done < <(printf '%s' "$body")
  plain=""; body=""
  refresh_names
  audit restore "*" "$restored restored, $skipped skipped"
  echo "restored: $restored, skipped: $skipped" >&2
  [ $skipped -eq 0 ] || echo "secret: use -f to replace the skipped secrets" >&2
}

cmd_log() {
  local n=20
  if [ "${1:-}" = "-n" ]; then n="$2"; shift 2; fi
  [ -f "$LOG" ] || return 0
  if [ $# -ge 1 ]; then
    awk -F'\t' -v name="$1" '{ split($4, a, " "); for (i in a) if (a[i] == name) { print; next } }' "$LOG" | tail -n "$n"
  else
    tail -n "$n" "$LOG"
  fi
}

cmd_has() {
  [ $# -eq 1 ] || die "has needs NAME"
  check_name "$1"
  ensure_keychain
  item_exists "$1"
}

cmd_ls() {
  local long=0 expiring="" days=30
  case "${1:-}" in
    -l) long=1 ;;
    --expiring) expiring=1; [ -z "${2:-}" ] || days="$2"
      [[ "$days" =~ ^[0-9]+$ ]] || die "DAYS must be a number" ;;
  esac
  ensure_keychain
  local name c g d left found=1
  while IFS=$'\t' read -r name c g; do
    d="$g"; [ "$d" != - ] || d=""; [ "$c" != - ] || c=""
    if [ -n "$expiring" ]; then
      [ -n "$d" ] || continue
      left="$(days_left "$d")"
      if [ "$left" -lt 0 ]; then printf 'EXPIRED  %-36s %s\n' "$name" "$d"; found=0
      elif [ "$left" -le "$days" ]; then printf 'soon     %-36s %s (%s days)\n' "$name" "$d" "$left"; found=0; fi
    elif [ $long -eq 1 ]; then
      printf '%-36s %-10s %s\n' "$name" "$d" "$c"
    else
      printf '%s\n' "$name"
    fi
  done < <(list_items)
  [ -z "$expiring" ] && refresh_names
  [ -z "$expiring" ] || return $found
}

cmd_rm() {
  [ $# -eq 1 ] || die "rm needs NAME"
  check_name "$1"
  ensure_keychain
  delete_item "$1" || die "not found: $1"
  refresh_names
  echo "removed: $1" >&2
}

# Parse one dotenv line. Sets PX (export prefix), PK (key), PV (value).
# Returns 1 for blank lines and comments.
parse_line() {
  local line="$1" rest q
  PX=""; PK=""; PV=""
  line="${line#"${line%%[![:space:]]*}"}"
  [ -n "$line" ] || return 1
  [ "${line:0:1}" != "#" ] || return 1
  if [ "${line:0:7}" = "export " ]; then PX="export "; line="${line:7}"; fi
  # 013: errors name the line number, not its text: the text can be a value
  [[ "$line" == *=* ]] || die "bad line ${LINE_NO:-?} (no '='), the text is not shown"
  PK="${line%%=*}"; PK="${PK%"${PK##*[![:space:]]}"}"
  [[ "$PK" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "bad env var name in line ${LINE_NO:-?}, the text is not shown"
  rest="${line#*=}"; rest="${rest#"${rest%%[![:space:]]*}"}"
  q="${rest:0:1}"
  if [ "$q" = "'" ]; then
    rest="${rest:1}"
    [[ "$rest" == *"'"* ]] || die "unclosed quote for $PK (multi-line values are not supported)"
    PV="${rest%%\'*}"
  elif [ "$q" = '"' ]; then
    PV="$(printf '%s' "${rest:1}" | perl -ne 'if (/^((?:[^"\\]|\\.)*)"/) { $v=$1; $v=~s/\\(["\\])/$1/g; $v=~s/\\n/\n/g; print $v; exit 0 } exit 3')" \
      || die "unclosed quote for $PK (multi-line values are not supported)"
  else
    PV="${rest%%[[:space:]]#*}"; PV="${PV%"${PV##*[![:space:]]}"}"
  fi
}

# If PV is a reference "secret:NAME", print NAME.
ref_name() {
  [[ "$PV" =~ ^secret:([A-Za-z_][A-Za-z0-9_.-]*)$ ]] || return 1
  printf '%s' "${BASH_REMATCH[1]}"
}

# Names and values read from the keychain by run, for the log and for --mask.
USED_NAMES=""
USED_VALUES=""

# Assignments of run in order: plain values now, references after one read of all values.
A_VAR=(); A_REF=(); A_VAL=()

load_env_file() {
  local file="$1" line name
  [ -f "$file" ] || die "no such file: $file"
  LINE_NO=0
  while IFS= read -r line || [ -n "$line" ]; do
    LINE_NO=$((LINE_NO + 1))
    parse_line "$line" || continue
    A_VAR+=("$PK")
    if name="$(ref_name)"; then
      item_known "$name" || die "not found: $name (referenced by $PK in $file)"
      A_REF+=("$name"); A_VAL+=("")
    else
      A_REF+=(""); A_VAL+=("$PV")
    fi
  done < "$file"
}

# Copy stdin to stdout and replace each value from SECRET__MASKS (one per line) with ***.
# Values of 8 characters or more are also replaced in base64, URL-safe base64 and URL encoding.
MASK_PL='use MIME::Base64; $| = 1;
my %m;
for my $v (grep { length } split /\n/, $ENV{SECRET__MASKS}) {
  $m{$v} = 1;
  next if length($v) < 8;
  my $b = encode_base64($v, "");
  (my $u = $b) =~ tr{+/}{-_};
  (my $p = $v) =~ s/([^A-Za-z0-9_.~-])/sprintf("%%%02X", ord $1)/ge;
  for my $x ($b, $u) { $m{$x} = 1; (my $n = $x) =~ s/=+$//; $m{$n} = 1 }
  $m{$p} = 1;
  (my $pl = $p) =~ s/%([0-9A-F]{2})/"%" . lc $1/ge; $m{$pl} = 1;
}
my @v = sort { length($b) <=> length($a) } keys %m;
my $re = @v ? join("|", map { quotemeta } @v) : undef;
while (my $l = <STDIN>) { $l =~ s/$re/***/g if defined $re; print $l }'

cmd_run() {
  local specs=() files=() mask=0 nomask=0
  [ -z "${SECRET_RUN_MASK:-}" ] || mask=1
  while [ $# -gt 0 ] && [ "$1" != "--" ]; do
    case "$1" in
      --mask) mask=1; shift ;;
      --no-mask) nomask=1; shift ;;
      -e|--env-file) [ $# -ge 2 ] || die "$1 needs FILE"; files+=("$2"); shift 2 ;;
      *) specs+=("$1"); shift ;;
    esac
  done
  [ "${1:-}" = "--" ] || die "run needs -- before the command"
  shift
  [ $# -ge 1 ] || die "run needs a command"
  # under Claude Code the output is always masked: the agent cannot forget the flag
  if [ -n "${CLAUDECODE:-}" ]; then
    [ $nomask -eq 0 ] || echo "secret: --no-mask is ignored for the agent" >&2
    mask=1
  elif [ $nomask -eq 1 ]; then
    mask=0
  fi
  if [ ${#specs[@]} -eq 0 ] && [ ${#files[@]} -eq 0 ]; then
    [ -f .env ] || die "run needs SPEC or -e FILE (no ./.env found)"
    files=(.env)
  fi
  ensure_keychain
  items_load
  local f spec var name value
  for f in ${files[@]+"${files[@]}"}; do load_env_file "$f"; done
  for spec in ${specs[@]+"${specs[@]}"}; do
    if [[ "$spec" == *=* ]]; then var="${spec%%=*}"; name="${spec#*=}"; else var="$spec"; name="$spec"; fi
    [[ "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "bad env var name: $var"
    check_name "$name"
    item_known "$name" || die "not found: $name"
    A_VAR+=("$var"); A_REF+=("$name"); A_VAL+=("")
  done
  local refs=() values=() i j=0
  for i in ${A_REF[@]+"${!A_REF[@]}"}; do [ -z "${A_REF[$i]}" ] || refs+=("${A_REF[$i]}"); done
  if [ ${#refs[@]} -gt 0 ]; then
    for name in "${refs[@]}"; do warn_expired "$name"; done
    while IFS= read -r value; do values+=("$value"); done \
      < <(read_values "use ${refs[*]} for $(basename "$1")" "${refs[@]}")
    [ ${#values[@]} -eq ${#refs[@]} ] || die "cannot read the secrets"
  fi
  for i in ${A_VAR[@]+"${!A_VAR[@]}"}; do
    if [ -n "${A_REF[$i]}" ]; then
      value="${values[$j]}"; j=$((j + 1))
      USED_NAMES="$USED_NAMES ${A_REF[$i]}"; USED_VALUES="$USED_VALUES$value"$'\n'
      export "${A_VAR[$i]}=$value"
    else
      export "${A_VAR[$i]}=${A_VAL[$i]}"
    fi
  done
  value=""; values=()
  audit run "${USED_NAMES# }" "$(basename "$1")"
  [ $mask -eq 1 ] || exec "$@"
  # stdout through a pipe, stderr through a FIFO: both masked, exit code of CMD kept
  local dir rc mpid
  dir="$(mktemp -d)"
  mkfifo "$dir/err"
  SECRET__MASKS="$USED_VALUES" perl -e "$MASK_PL" < "$dir/err" >&2 &
  mpid=$!
  set +e
  "$@" 2> "$dir/err" | SECRET__MASKS="$USED_VALUES" perl -e "$MASK_PL"
  rc=${PIPESTATUS[0]}
  wait "$mpid"
  rm -rf "$dir"
  exit "$rc"
}

# Show which keys of an env file are references and whether they resolve. Prints no values.
cmd_check() {
  local file="${1:-.env}" line name bad=0
  [ -f "$file" ] || die "no such file: $file"
  ensure_keychain
  items_load
  LINE_NO=0
  while IFS= read -r line || [ -n "$line" ]; do
    LINE_NO=$((LINE_NO + 1))
    parse_line "$line" || continue
    if name="$(ref_name)"; then
      if item_known "$name"; then echo "ok       $PK -> $name"; warn_expired "$name"
      else echo "MISSING  $PK -> $name"; bad=1; fi
    else
      echo "plain    $PK"
    fi
  done < "$file"
  return $bad
}

# Move plain values of an env file into the Keychain and rewrite the file with references.
cmd_import() {
  local file="" prefix="" keep=0 keys="" refs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -k|--keep) keep=1; shift ;;
      -p|--prefix) [ $# -ge 2 ] || die "$1 needs PREFIX"; prefix="$2"; shift 2 ;;
      # 013: only these keys; the other lines stay as they are
      --keys) [ $# -ge 2 ] || die "--keys needs KEY,KEY"; keys=",$2,"; shift 2 ;;
      # 013: KEY becomes a reference to the existing secret NAME, nothing is stored
      --ref) [[ "${2:-}" =~ ^[A-Za-z_][A-Za-z0-9_]*=[A-Za-z_][A-Za-z0-9_.-]*$ ]] || die "--ref needs KEY=NAME"
        refs+=("$2"); shift 2 ;;
      *) [ -z "$file" ] || die "import takes one FILE"; file="$1"; shift ;;
    esac
  done
  file="${file:-.env}"
  [ -f "$file" ] || die "no such file: $file"
  ensure_keychain
  items_load
  local tmp line name n=0 names=() values=() owners=() script="" i c g
  local r rk seen=","
  for r in ${refs[@]+"${refs[@]}"}; do item_known "${r#*=}" || die "not found: ${r#*=} (--ref ${r%%=*})"; done
  tmp="$(mktemp "$(dirname "$file")/.secret-import.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  LINE_NO=0
  while IFS= read -r line || [ -n "$line" ]; do
    LINE_NO=$((LINE_NO + 1))
    rk=""
    if parse_line "$line" && [ -n "$PV" ] && ! ref_name >/dev/null; then
      for r in ${refs[@]+"${refs[@]}"}; do [ "${r%%=*}" != "$PK" ] || rk="${r#*=}"; done
    fi
    if [ -n "$rk" ]; then
      printf '%s%s=secret:%s\n' "$PX" "$PK" "$rk" >> "$tmp"
      seen+="$PK,"
      echo "reference: $PK -> $rk" >&2
    elif [ -n "$PK" ] && [ -n "$PV" ] && ! ref_name >/dev/null \
        && { { [ -z "$keys" ] && [ ${#refs[@]} -eq 0 ]; } || [[ "$keys" == *",$PK,"* ]]; }; then
      # with --ref and without --keys only the references change: no other key moves by surprise
      seen+="$PK,"
      name="${prefix}${PK}"
      check_name "$name"
      [[ "$PV" != *$'\n'* ]] || die "multi-line values are not supported: $PK"
      names+=("$name"); values+=("$PV")
      printf '%s%s=secret:%s\n' "$PX" "$PK" "$name" >> "$tmp"
    else
      printf '%s\n' "$line" >> "$tmp"
    fi
  done < "$file"
  local k
  for k in $(printf '%s' "${keys//,/ }") ${refs[@]+"${refs[@]%%=*}"}; do
    [[ "$seen" == *",$k,"* ]] || die "no plain value for $k in $file, nothing changed"
  done
  if [ ${#names[@]} -gt 0 ] && [ -x "$HELPER" ] && ! in_store; then
    while IFS= read -r line; do owners+=("$line"); done < <("$HELPER" owner "$KC" "${names[@]}" 2>/dev/null)
  fi
  local records=""
  for i in ${names[@]+"${!names[@]}"}; do
    name="${names[$i]}"
    c="$(get_comment "$name")"; g="$(get_expiry "$name")"
    if in_store; then
      records+="$(hex "$name") $(hex "${values[$i]}") $(hex "$c") $(hex "$g")"$'\n'
    elif is_protected || [ "${owners[$i]:-}" = mine ]; then
      write_item "$name" "${values[$i]}" "$c" "$g" || die "keychain write failed: $name"
    else
      script+="add-generic-password -U -a $ACCT -s \"$name\" -D \"secret-cli\" -j \"$(esc "$c")\" -G \"${g:+expires=$g}\" -w \"$(esc "${values[$i]}")\" \"$KC\""$'\n'
    fi
    n=$((n + 1))
  done
  # one security session for all items of security; the values go through its stdin
  [ -z "$script" ] || printf '%s' "$script" | security -i >/dev/null 2>&1 || die "keychain write failed"
  # Secure Enclave store: one helper call for all items
  [ -z "$records" ] || printf '%s' "$records" | "$STORE" write || die "keychain write failed"
  script=""; records=""; values=()
  ITEMS_LOADED=0
  items_load
  for name in ${names[@]+"${names[@]}"}; do
    item_known "$name" || die "keychain write not confirmed: $name"
    echo "stored: $name" >&2
  done
  trap - EXIT
  refresh_names
  if [ $keep -eq 1 ]; then
    rm -f "$tmp"
    echo "imported $n value(s); $file not changed" >&2
  else
    chmod "$(stat -f %Lp "$file")" "$tmp"
    mv "$tmp" "$file"
    echo "imported $n value(s); $file now has references only" >&2
  fi
}

# Move all secrets between the file keychain and the Secure Enclave store (009, 018).
cmd_migrate() {
  case "${1:-}" in
    --backup)
      [ $# -ge 2 ] || die "migrate needs --backup FILE"
      [ $# -eq 2 ] || [ "${3:-}" = --pass-stdin ] || die "migrate --backup FILE takes only --pass-stdin"
      migrate_to_store "$2" "${3:-}" ;;
    --back) [ $# -eq 1 ] || die "migrate --back takes no arguments"; migrate_back ;;
    *) die "migrate needs --backup FILE or --back" ;;
  esac
}

# Values go through the memory of this process and pipes, never through argv or the disk.
migrate_to_store() {
  local file="$1" pass=()
  [ -z "${2:-}" ] || pass=(--pass-stdin)
  ! in_store || die "the $STORE_NAME is already on"
  [ -n "$STORE_MODE_FILE" ] || die "migrate with a test keychain needs SECRET_STORE_MODE"
  [ -x "$STORE" ] || die "the store helper is not built (run $ROOT/install.sh, it needs swiftc)"
  "$STORE" ping >/dev/null 2>&1 || die "the store helper does not start (run $ROOT/install.sh)"
  local names=() comments=() expiries=() values=() name c g v i grace=1800
  if [ -f "$KC" ]; then
    ensure_keychain
    [ ! -e "$file" ] || die "exists: $file"
    ( cmd_export ${pass[@]+"${pass[@]}"} "$file" ) || die "migrate: the backup failed, nothing changed"
    while IFS=$'\t' read -r name c g; do names+=("$name"); comments+=("$c"); expiries+=("$g"); done < <(list_items)
    if [ ${#names[@]} -gt 0 ]; then
      while IFS= read -r v; do values+=("$v"); done \
        < <(read_values "move ${#names[@]} secrets to the $STORE_NAME" "${names[@]}")
      [ ${#values[@]} -eq ${#names[@]} ] || die "migrate: cannot read the secrets, nothing changed"
    fi
    if is_protected && [ -x "$HELPER" ]; then
      g="$("$HELPER" policy show "$KC" 2>/dev/null)"; g="${g#grace=}"
      if [[ "$g" =~ ^[0-9]+$ ]] && [ "$g" -le 3600 ]; then grace="$g"; fi
    fi
  else
    echo "migrate: no file keychain, the $STORE_NAME starts empty" >&2
  fi
  "$STORE" policy init "$grace" || die "migrate: cannot write the policy, nothing changed"
  local records=""
  for i in ${names[@]+"${!names[@]}"}; do
    c="${comments[$i]}"; [ "$c" != - ] || c=""
    g="${expiries[$i]}"; [ "$g" != - ] || g=""
    records+="$(hex "${names[$i]}") $(hex "${values[$i]}") $(hex "$c") $(hex "$g")"$'\n'
  done
  [ -z "$records" ] || printf '%s' "$records" | "$STORE" write || die "migrate: write failed, the file keychain is still in use"
  records=""
  if [ ${#names[@]} -gt 0 ]; then
    local got=()
    while IFS= read -r v; do got+=("$v"); done < <("$STORE" read "check ${#names[@]} secrets in the $STORE_NAME" "${names[@]}" \
      | while IFS= read -r v; do printf '%s' "$v" | xxd -r -p; echo; done)
    [ ${#got[@]} -eq ${#names[@]} ] || die "migrate: cannot read the secrets back, the file keychain is still in use"
    for i in "${!names[@]}"; do
      [ "${got[$i]}" = "${values[$i]}" ] || die "migrate: ${names[$i]} differs, the file keychain is still in use"
    done
    got=()
  fi
  values=()
  ( umask 077; mkdir -p "$(dirname "$STORE_MODE_FILE")" && echo vault > "$STORE_MODE_FILE" ) || die "cannot write $STORE_MODE_FILE"
  # The old copies go: else a deleted mode file would give them back without the new protection.
  # FILE has them, encrypted.
  local left=0
  IN_STORE=0
  for name in ${names[@]+"${names[@]}"}; do delete_item "$name" || left=$((left + 1)); done
  IN_STORE=1
  refresh_names
  audit migrate "*" "${#names[@]} secrets to the $STORE_NAME"
  echo "migrate: ${#names[@]} secrets in the $STORE_NAME" >&2
  if [ $left -gt 0 ]; then
    echo "secret: warning: $left secrets are still in $KC, delete them there" >&2
  elif [ -f "$KC" ]; then
    echo "migrate: the secrets are removed from $KC; the backup is in $file" >&2
  fi
}

migrate_back() {
  in_store || die "the $STORE_NAME is off"
  ensure_keychain
  local names=() comments=() expiries=() values=() name c g v i
  while IFS=$'\t' read -r name c g; do names+=("$name"); comments+=("$c"); expiries+=("$g"); done < <(list_items)
  if [ ${#names[@]} -gt 0 ]; then
    while IFS= read -r v; do values+=("$v"); done \
      < <(read_values "move ${#names[@]} secrets back to the file keychain" "${names[@]}")
    [ ${#values[@]} -eq ${#names[@]} ] || die "migrate: cannot read the secrets, nothing changed"
  fi
  IN_STORE=0
  # no file keychain: create it (asks for a new keychain password)
  if [ -f "$KC" ]; then ensure_keychain; else cmd_init; fi
  for i in ${names[@]+"${!names[@]}"}; do
    c="${comments[$i]}"; [ "$c" != - ] || c=""
    g="${expiries[$i]}"; [ "$g" != - ] || g=""
    write_item "${names[$i]}" "${values[$i]}" "$c" "$g" || die "migrate: cannot write ${names[$i]}, the $STORE_NAME is still in use"
    item_exists "${names[$i]}" || die "migrate: ${names[$i]} not confirmed, the $STORE_NAME is still in use"
  done
  values=()
  rm -f "$STORE_MODE_FILE"
  [ ${#names[@]} -eq 0 ] || "$STORE" delete "${names[@]}" >/dev/null 2>&1 || true
  "$STORE" lock 2>/dev/null || true
  refresh_names
  audit migrate "*" "${#names[@]} secrets back to the file keychain"
  echo "migrate: ${#names[@]} secrets back in $KC" >&2
}

[ $# -ge 1 ] || { usage; exit 1; }
sub="$1"; shift
case "$sub" in
  init) cmd_init ;;
  migrate) cmd_migrate "$@" ;;
  touchid) cmd_touchid "$@" ;;
  __rehelper) cmd_rehelper "$@" ;;
  unlock) cmd_unlock ;;
  lock) cmd_lock ;;
  set) cmd_set "$@" ;;
  ask) cmd_ask "$@" ;;
  get) cmd_get "$@" ;;
  gen) cmd_gen "$@" ;;
  log) cmd_log "$@" ;;
  copy) cmd_copy "$@" ;;
  gh) cmd_gh "$@" ;;
  mv) cmd_mv "$@" ;;
  expire) cmd_expire "$@" ;;
  export) cmd_export "$@" ;;
  restore) cmd_restore "$@" ;;
  has) cmd_has "$@" ;;
  ls|list) cmd_ls "$@" ;;
  note) cmd_note "$@" ;;
  rm|del|delete) cmd_rm "$@" ;;
  run) cmd_run "$@" ;;
  check) cmd_check "$@" ;;
  import) cmd_import "$@" ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
