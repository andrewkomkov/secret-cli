{
  "manifest_version": 3,
  "name": "Secret Cookie Bridge",
  "version": "0.1.0",
  "description": "Send the cookies of the current site to the local secret command as a cookie jar.",
  "permissions": ["cookies", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Send cookies to secret",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
