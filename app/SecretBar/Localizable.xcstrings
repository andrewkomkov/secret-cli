      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Простой — время без обращений к секретам. Предел — 8 часов. Блокировка экрана и сон заканчивают время сразу. Изменение подтверждается Touch ID."
          }
        }
      }
    },
